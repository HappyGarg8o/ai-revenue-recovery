# Copy to .env and fill in. Never commit the filled-in version.

# --- Supabase (required) -----------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# --- The design constraint ---------------------------------------------------
# true  = no external sends; every action is recorded in audit_log instead.
# false = real WhatsApp messages and real phone calls go out.
DRY_RUN=true

# --- WhatsApp tier (Twilio) --------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Required by Twilio for sends outside the 24h session window. Gated behind a
# paid account upgrade — this is why DRY_RUN exists.
TWILIO_CONTENT_SID=

# --- Voice tier --------------------------------------------------------------
# Bolna is primary (Hinglish + Indian telephony), Vapi is the fallback.
# Provider is auto-detected from whichever key is set.
VOICE_PROVIDER=bolna
BOLNA_API_KEY=
BOLNA_AGENT_ID=
BOLNA_FROM_NUMBER=

VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=

# --- Payment links -----------------------------------------------------------
# Stub base for the recovery link. Swap for real Razorpay Payment Links.
PAYMENT_LINK_BASE=https://rzp.io/i
